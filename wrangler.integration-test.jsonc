{
  "name": "dns-panel-integration-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "dns-panel-integration-test", "database_id": "00000000-0000-0000-0000-000000000003" }],
  "vars": {
    "CLOUDFLARE_API_TOKEN": "local-test-token",
    "SESSION_KEY": "local-test-session-key-1234567890123456",
    "TOTP_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "BOOTSTRAP_KEY": "local-test-bootstrap-key-1234567890123456",
    "CF_API_BASE": "http://127.0.0.1:8999/client/v4"
  }
}
