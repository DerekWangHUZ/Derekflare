{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dns-delegation-panel",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "keep_vars": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Preserve the D1 binding created in Worker Settings without auto-provisioning a database.
  "unsafe": { "metadata": { "keep_bindings": ["d1"] } },
  "triggers": { "crons": ["0 */6 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
